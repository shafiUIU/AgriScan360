# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Database (SQLite file — do not commit, can be large) ──────────────────────
laptop_server/db/*.db
laptop_server/db/*.db-shm
laptop_server/db/*.db-wal

# ── Scan images (can be hundreds of MBs) ──────────────────────────────────────
laptop_server/static/scans/

# -- AI model files & checkpoints (large binary) -------------------------------
*.pth
*.pt
*.tflite
checkpoints/
**/checkpoints/
training/**/checkpoints/
training/**/results/
laptop_server/models/*.onnx
laptop_server/models/*.pkl
laptop_server/model/*.onnx
laptop_server/model/*.pt
laptop_server/model/*.tflite

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
*.secret

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Build artifacts ────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Datasets (can be tens of GBs — do not commit to git) ─────────────────────
datasets/
*.zip
*.tar
*.gz
*.rar
