# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Database (SQLite file — do not commit, can be large) ──────────────────────
laptop_server/db/*.db
laptop_server/db/*.db-shm
laptop_server/db/*.db-wal

# ── Scan images (can be hundreds of MBs) ──────────────────────────────────────
laptop_server/static/scans/

# ── AI model files (large binary) ─────────────────────────────────────────────
laptop_server/model/*.onnx
laptop_server/model/*.pt
laptop_server/model/*.tflite

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
*.secret

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Build artifacts ────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
